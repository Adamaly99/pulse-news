---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="PulseNews | L'actualité en temps réel & Analyses" 
  description="Plateforme d'information haute performance, conçue pour une vitesse maximale et optimisée pour les moteurs de recherche Google et l'IA."
>
  <section style="text-align: center; padding: 3rem 0;">
    <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(225, 29, 72, 0.15); border: 1px solid var(--accent); border-radius: 50px; color: var(--accent); font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem;">
      • SEO Ultra-Optimisé & GEO Compatible
    </div>
    <h1 style="font-size: 3rem; font-weight: 800; color: var(--text-bright); line-height: 1.2; margin-bottom: 1rem;">
      PulseNews
    </h1>
    <p style="font-size: 1.25rem; color: #9ca3af; max-width: 680px; margin: 0 auto;">
      Votre source d'information rapide, fiable et structurée pour les moteurs de recherche et les intelligences artificielles.
    </p>
  </section>
</BaseLayout>
