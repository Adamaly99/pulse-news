---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/*.md');
  const categories = [...new Set(posts.map((p) => (p.frontmatter.category || 'technologie').toLowerCase()))];

  return categories.map((category) => {
    const filteredPosts = posts.filter(
      (p) => (p.frontmatter.category || 'technologie').toLowerCase() === category
    );
    return {
      params: { category },
      props: { posts: filteredPosts },
    };
  });
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`Catégorie : ${category}`} description={`Tous les articles de la catégorie ${category}`}>
  <main class="container">
    <h1>Catégorie : <span class="highlight">{category}</span></h1>
    <div class="articles-grid">
      {posts.map((post) => {
        const slug = post.file.split('/').pop().replace('.md', '');
        return (
          <article class="card">
            <h2>
              <a href={`/news/${slug}/`}>{post.frontmatter.title}</a>
            </h2>
            <p>{post.frontmatter.description}</p>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .container { max-width: 1000px; margin: 0 auto; padding: 2rem 1rem; }
  h1 { font-size: 2rem; margin-bottom: 2rem; text-transform: capitalize; }
  .highlight { color: #38bdf8; }
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .card { background: #1e293b; padding: 1.5rem; border-radius: 0.5rem; }
  .card h2 a { color: #f8fafc; text-decoration: none; font-size: 1.25rem; }
</style>
