---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/**/*.md');
  return posts.map((post) => {
    const slug = post.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

const {
  title = 'Article',
  description = '',
  pubDate,
  category = 'technologie',
  keyTakeaways = [],
  faq = [],
  sourceUrl,
  sourceName
} = post.frontmatter || {};

const formattedDate = new Date(pubDate || Date.now()).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description} article={true}>
  <article class="news-article">
    <header class="article-header">
      <span class="category-badge">{category}</span>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate}>{formattedDate}</time>
        {sourceUrl && (
          <span class="source">
            • Source originale : <a href={sourceUrl} target="_blank" rel="noopener noreferrer">{sourceName || 'Consulter'}</a>
          </span>
        )}
      </div>
    </header>

    {keyTakeaways && keyTakeaways.length > 0 && (
      <section class="takeaways-box">
        <h2>⚡ En bref</h2>
        <ul>
          {keyTakeaways.map((point: string) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    )}

    <div class="article-body">
      <Content />
    </div>

    {faq && faq.length > 0 && (
      <section class="faq-section">
        <h2>❓ Foire Aux Questions</h2>
        <div class="faq-list">
          {faq.map((item: { question: string; answer: string }) => (
            <div class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>

  {faq && faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map((item: { question: string; answer: string }) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    })} />
  )}
</BaseLayout>

<style>
  .news-article {
    max-width: 800px;
    margin: 0 auto;
  }

  .category-badge {
    display: inline-block;
    background: var(--accent-color, #38bdf8);
    color: #0f172a;
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .article-header h1 {
    font-size: 2.25rem;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .meta {
    color: #94a3b8;
    font-size: 0.875rem;
    margin-bottom: 2rem;
  }

  .meta a {
    color: var(--accent-color, #38bdf8);
    text-decoration: underline;
  }

  .takeaways-box {
    background: #1e293b;
    border-left: 4px solid var(--accent-color, #38bdf8);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
  }

  .takeaways-box h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .takeaways-box ul {
    padding-left: 1.25rem;
  }

  .takeaways-box li {
    margin-bottom: 0.5rem;
  }

  .article-body {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 3rem;
  }

  .faq-section {
    background: #1e293b;
    padding: 2rem;
    border-radius: 0.75rem;
    margin-top: 3rem;
  }

  .faq-section h2 {
    margin-bottom: 1.5rem;
  }

  .faq-item {
    margin-bottom: 1.5rem;
  }

  .faq-item:last-child {
    margin-bottom: 0;
  }

  .faq-item h3 {
    font-size: 1.1rem;
    color: var(--accent-color, #38bdf8);
    margin-bottom: 0.5rem;
  }
</style>

