---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('content');
  return articles.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, pubDate, category, author, sourceName, sourceUrl, keyTakeaways, faq } = entry.data;

const formattedDate = new Date(pubDate).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const currentUrl = `[https://pulse-news-three.vercel.app/news/$](https://pulse-news-three.vercel.app/news/$){entry.slug}`;

// Schema.org NewsArticle
const newsArticleSchema = {
  "@context": "[https://schema.org](https://schema.org)",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "datePublished": pubDate,
  "dateModified": pubDate,
  "mainEntityOfPage": currentUrl,
  "author": {
    "@type": "Organization",
    "name": author || "Rédaction PulseNews",
    "url": "[https://pulse-news-three.vercel.app/a-propos](https://pulse-news-three.vercel.app/a-propos)"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PulseNews",
    "url": "[https://pulse-news-three.vercel.app](https://pulse-news-three.vercel.app)"
  }
};

// Schema.org FAQPage (si la FAQ existe)
const faqSchema = faq && faq.length > 0 ? {
  "@context": "[https://schema.org](https://schema.org)",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

// Schema.org Breadcrumb
const breadcrumbSchema = {
  "@context": "[https://schema.org](https://schema.org)",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "[https://pulse-news-three.vercel.app](https://pulse-news-three.vercel.app)" },
    { "@type": "ListItem", "position": 2, "name": category || "Tech", "item": `[https://pulse-news-three.vercel.app](https://pulse-news-three.vercel.app)` },
    { "@type": "ListItem", "position": 3, "name": title, "item": currentUrl }
  ]
};
---

<BaseLayout title={`${title} | PulseNews`} description={description}>
  <!-- Injection JSON-LD Données Enrichies -->
  <script type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article style="max-width: 820px; margin: 0 auto; padding: 2rem 1rem; line-height: 1.8;">
    
    <!-- Fil d'Ariane -->
    <nav style="font-size: 0.85rem; color: #9ca3af; margin-bottom: 1.5rem;">
      <a href="/" style="color: #9ca3af; text-decoration: none;">Accueil</a> &rsaquo; 
      <span style="text-transform: capitalize; color: var(--accent); font-weight: 600;">{category || 'Actualités'}</span>
    </nav>

    <!-- En-tête Article -->
    <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
      <span style="background: rgba(59,130,246,0.15); color: #60a5fa; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">
        {category || 'Tech'}
      </span>
      <h1 style="font-size: 2.3rem; color: var(--text-bright); margin: 1rem 0 0.5rem 0; line-height: 1.25;">{title}</h1>
      <p style="font-size: 1.15rem; color: #9ca3af; margin-bottom: 1rem;">{description}</p>
      
      <div style="display: flex; gap: 1rem; font-size: 0.85rem; color: #6b7280; flex-wrap: wrap; align-items: center;">
        <span>Par <strong>{author || 'Rédaction PulseNews'}</strong></span>
        <span>•</span>
        <time datetime={pubDate}>{formattedDate}</time>
        <span>•</span>
        <span style="background: rgba(16,185,129,0.1); color: #10b981; padding: 2px 8px; border-radius: 4px;">Analyse Vérifiée EEAT</span>
      </div>
    </header>

    <!-- Bloc À Retenir (Points Clés) -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div style="background: rgba(30, 41, 59, 0.7); border-left: 4px solid var(--accent); padding: 1.25rem 1.5rem; border-radius: 8px; margin-bottom: 2.5rem;">
        <h3 style="margin-top: 0; color: var(--accent); font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
          📌 À retenir (Synthèse)
        </h3>
        <ul style="margin: 0; padding-left: 1.2rem; color: #e2e8f0; font-size: 0.95rem;">
          {keyTakeaways.map((item: string) => (
            <li style="margin-bottom: 0.4rem;">{item}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Contenu Principal -->
    <div class="article-body" style="font-size: 1.05rem; color: #cbd5e1;">
      <Content />
    </div>

    <!-- Section FAQ si présente -->
    {faq && faq.length > 0 && (
      <section style="margin-top: 3rem; background: var(--card-bg); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px;">
        <h2 style="color: var(--text-bright); font-size: 1.4rem; margin-top: 0;">Foire Aux Questions (FAQ)</h2>
        {faq.map((item: { question: string; answer: string }) => (
          <div style="margin-bottom: 1rem;">
            <h4 style="color: var(--accent); margin-bottom: 0.3rem;">❓ {item.question}</h4>
            <p style="margin: 0; font-size: 0.95rem; color: #9ca3af;">{item.answer}</p>
          </div>
        ))}
      </section>
    )}

    <!-- Encadré Source & Transparence -->
    <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.9rem; color: #6b7280;">
      <p style="margin-bottom: 0.5rem;">
        <strong>Transparence & Sources :</strong> Cet article a été rédigé avec l'assistance d'outils d'IA sous supervision éditoriale humaine. Source principale : <a href={sourceUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent);">{sourceName || 'Presse Spécialisée'}</a>.
      </p>
      <p style="margin: 0;">
        Consultez notre <a href="/a-propos" style="color: #9ca3af;">Charte Éditoriale et Politique IA</a>.
      </p>
    </footer>

  </article>
</BaseLayout>
