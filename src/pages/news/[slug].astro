---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/*.md');
  return posts.map(post => {
    const slug = post.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { title, description, pubDate, category = 'Actualités' } = post.frontmatter;

const fallbackImages = [
  "https://images.unsplash.com/photo-1677442136019-21780efad99a?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1518770660439-4636190af475?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1563986768609-322da13575f3?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&auto=format&fit=crop"
];

const fallbackIndex = (title || '').length % fallbackImages.length;
const displayImage = fallbackImages[fallbackIndex];
const Content = post.Content;

// Calculation of reading time
const rawText = post.rawContent ? post.rawContent() : '';
const wordCount = rawText.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = new Date(pubDate).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <article style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    
    <!-- En-tête de l'article -->
    <div style="margin-bottom: 2rem;">
      <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 0.75rem; font-size: 0.85rem;">
        <span style="color: var(--accent); font-weight: 700; text-transform: uppercase;">{category}</span>
        <span style="color: #6b7280;">•</span>
        <time style="color: #6b7280;">{formattedDate}</time>
        <span style="color: #6b7280;">•</span>
        <span style="color: #9ca3af;">⏱️ {readingTime} min de lecture</span>
      </div>
      
      <h1 style="font-size: 2.4rem; font-weight: 800; line-height: 1.25; margin-bottom: 1rem;">{title}</h1>
      <p style="font-size: 1.15rem; color: #9ca3af; line-height: 1.5;">{description}</p>
    </div>

    <!-- Image principale -->
    <div style="margin-bottom: 2.5rem; overflow: hidden; border-radius: 12px; max-height: 450px;">
      <img 
        src={displayImage} 
        alt={title || 'Image d\'article'} 
        style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px; display: block;"
      />
    </div>

    <!-- Contenu de l'article -->
    <div class="prose" style="font-size: 1.05rem; line-height: 1.7; color: #d1d5db; margin-bottom: 3rem;">
      <Content />
    </div>

    ---

    <!-- Zone de Partage Social -->
    <div style="margin-top: 2.5rem; padding: 1.5rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; text-align: center;">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-bright);">Partager cet article</h3>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a 
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' - https://pulse-news-three.vercel.app/news/' + Astro.params.slug)}`} 
          target="_blank" 
          rel="noopener noreferrer"
          style="padding: 0.5rem 1.25rem; background: #25D366; color: #fff; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none;"
        >
          WhatsApp
        </a>
        <a 
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent('https://pulse-news-three.vercel.app/news/' + Astro.params.slug)}`} 
          target="_blank" 
          rel="noopener noreferrer"
          style="padding: 0.5rem 1.25rem; background: #000; color: #fff; border: 1px solid #333; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none;"
        >
          X (Twitter)
        </a>
        <a 
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://pulse-news-three.vercel.app/news/' + Astro.params.slug)}`} 
          target="_blank" 
          rel="noopener noreferrer"
          style="padding: 0.5rem 1.25rem; background: #0A66C2; color: #fff; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none;"
        >
          LinkedIn
        </a>
      </div>
    </div>

  </article>
</BaseLayout>
