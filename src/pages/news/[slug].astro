---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/*.md');
  return posts.map(post => {
    const slug = post.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { title, description, pubDate, category = 'Actualités' } = post.frontmatter;

const fallbackImages = [
  "https://images.unsplash.com/photo-1677442136019-21780efad99a?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1518770660439-4636190af475?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1563986768609-322da13575f3?w=1200&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&auto=format&fit=crop"
];

const fallbackIndex = (title || '').length % fallbackImages.length;
const displayImage = fallbackImages[fallbackIndex];
const Content = post.Content;
---

<BaseLayout title={title} description={description}>
  <article style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    
    <div style="margin-bottom: 2rem;">
      <span style="color: var(--accent); font-weight: 700; text-transform: uppercase;">{category}</span>
      <h1 style="font-size: 2.5rem; font-weight: 800; margin: 0.5rem 0;">{title}</h1>
    </div>

    <div style="margin-bottom: 2rem; overflow: hidden; border-radius: 12px; max-height: 450px;">
      <img 
        src={displayImage} 
        alt={title || 'Image d\'article'} 
        style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px; display: block;"
      />
    </div>

    <div class="prose">
      <Content />
    </div>

  </article>
</BaseLayout>
