---
import BaseLayout from '../layouts/BaseLayout.astro';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "PulseNews",
  "url": "https://pulse-news-three.vercel.app",
  "publishingPrinciples": "https://pulse-news-three.vercel.app/a-propos",
  "founder": {
    "@type": "Person",
    "name": "Adama",
    "jobTitle": "Fondateur & Éditeur",
  },
};
---

<BaseLayout title="Équipe & Méthode | PulseNews" description="Qui est derrière PulseNews et comment les articles sont produits.">
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <main class="team-page">
    <header class="team-header">
      <h1>Qui est derrière PulseNews</h1>
      <p>Un projet indépendant, pas une rédaction de plusieurs journalistes.</p>
    </header>

    <section class="team-card">
      <h2>Fondateur</h2>
      <p>
        PulseNews est un projet solo, créé et maintenu par <strong>Adama</strong>, développeur autodidacte.
        Pas d'équipe de journalistes derrière ce site — juste une personne qui construit, seule, un média
        technologique francophone avec les moyens du bord.
      </p>
    </section>

    <section class="method-card">
      <h2>Comment les articles sont produits</h2>
      <p>Par souci d'honnêteté envers nos lecteurs, voici le processus réel, sans enjolivure :</p>
      <ol>
        <li>
          <strong>Veille automatisée :</strong> un système surveille en continu plusieurs flux d'actualité tech
          (IA, cybersécurité, mobile, cloud) et détecte les sujets pertinents.
        </li>
        <li>
          <strong>Rédaction assistée par IA :</strong> chaque article est rédigé par un modèle d'intelligence
          artificielle à partir de la source détectée, avec des consignes strictes de mise en contexte et
          d'analyse — jamais une simple reformulation de la dépêche d'origine.
        </li>
        <li>
          <strong>Attribution systématique :</strong> chaque article affiche un lien direct vers sa source
          originale, visible en tête d'article — vous pouvez toujours vérifier par vous-même.
        </li>
        <li>
          <strong>Amélioration continue :</strong> le processus est révisé régulièrement pour corriger les erreurs
          et améliorer la fiabilité, mais il n'y a pas, à ce stade, de relecture humaine systématique de chaque
          article avant publication.
        </li>
      </ol>
      <p>
        Une erreur factuelle ? Écrivez-nous, elle sera corrigée rapidement — voir notre
        <a href="/a-propos">charte de transparence</a> et notre <a href="/contact">page de contact</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .team-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .team-header {
    border-bottom: 1px solid var(--border-color, #334155);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .team-header h1 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .team-header p {
    color: var(--text-muted, #94a3b8);
    font-size: 1.1rem;
  }

  .team-card,
  .method-card {
    background: var(--card-bg, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 12px;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .team-card h2,
  .method-card h2 {
    color: var(--accent-color, #38bdf8);
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .method-card ol {
    padding-left: 1.25rem;
    color: var(--text-muted, #94a3b8);
  }

  .method-card li {
    margin-bottom: 0.85rem;
  }

  .method-card li strong {
    color: var(--text-color, #f8fafc);
  }

  .method-card a {
    color: var(--accent-color, #38bdf8);
  }
</style>
