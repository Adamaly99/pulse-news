---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | PulseNews" description="Contacter la rédaction de PulseNews.">
  <section style="max-width: 800px; margin: 0 auto; padding: 2rem 0; line-height: 1.8;">
    <h1 style="font-size: 2.2rem; color: var(--text-bright); margin-bottom: 1.5rem;">Contactez la Rédaction</h1>
    <p>Vous souhaitez nous contacter pour une information, une correction sur un article ou une demande de partenariat ?</p>
    
    <div style="background: var(--card-bg); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px; margin-top: 2rem;">
      <p style="margin: 0; font-size: 1.1rem;"><strong>Email de la rédaction :</strong> <a href="mailto:contact@pulsenews.sn" style="color: var(--accent);">contact@pulsenews.sn</a></p>
    </div>
  </section>
</BaseLayout>
