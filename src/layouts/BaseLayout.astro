---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} article={article} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="logo">
          Pulse<span>News</span>
        </a>
        <nav class="main-nav">
          <a href="/">Accueil</a>
          <a href="/category/intelligence-artificielle">IA</a>
          <a href="/category/cybersecurite">Cybersécurité</a>
          <a href="/category/technologie">Technologie</a>
          <a href="/a-propos">À Propos</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} PulseNews. Tous droits réservés.</p>
    </footer>

    <style is:global>
      :root {
        --bg-color: #0f172a;
        --card-bg: #1e293b;
        --text-color: #f8fafc;
        --text-muted: #94a3b8;
        --accent-color: #38bdf8;
        --border-color: #334155;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
      }

      .header-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .site-header {
        border-bottom: 1px solid var(--border-color);
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
      }

      .logo span {
        color: var(--accent-color);
      }

      .main-nav {
        display: flex;
        gap: 1.5rem;
      }

      .main-nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
      }

      .main-nav a:hover {
        color: var(--accent-color);
      }

      .main-content {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        min-height: 80vh;
      }

      .site-footer {
        border-top: 1px solid var(--border-color);
        text-align: center;
        padding: 2rem;
        color: var(--text-muted);
        font-size: 0.875rem;
      }
    </style>
  </body>
</html>
