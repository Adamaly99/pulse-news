---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  author?: string;
  datePublished?: string;
}

const { title, description, image, article = false, author, datePublished } = Astro.props;

const CATEGORY_LABELS = {
  'intelligence-artificielle': 'IA',
  'cybersecurite': 'Cybersécurité',
  'android': 'Android',
  'apple': 'Apple',
  'cloud': 'Cloud',
  'startups': 'Startups',
  'robotique': 'Robotique',
  'technologie': 'Technologie',
};
const CATEGORY_ORDER = Object.keys(CATEGORY_LABELS);

// La navigation ne liste QUE les catégories qui ont réellement des articles publiés,
// pour ne jamais pointer vers une page vide (voir audit : liens morts vers /android, /apple).
const allPosts = await Astro.glob('../content/**/*.md');
const activeCategories = [...new Set(allPosts.map((p) => (p.frontmatter.category || 'technologie').toLowerCase()))]
  .sort((a, b) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b));
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} type={article ? 'article' : 'website'} author={author} datePublished={datePublished} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="PulseNews RSS" href="/rss.xml" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BD5X1MS0ZD"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BD5X1MS0ZD');
    </script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-19V07F5GQY"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-19V07F5GQY');
</script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="logo">
          Pulse<span>News</span>
        </a>
        <nav class="main-nav">
          <a href="/">Accueil</a>
          {activeCategories.map((cat) => (
            <a href={`/category/${cat}`}>{CATEGORY_LABELS[cat] || cat}</a>
          ))}
          <a href="/a-propos">À Propos</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="footer-nav" aria-label="Liens du pied de page">
        <a href="/equipe">Équipe & Méthode</a>
        <a href="/contact">Contact</a>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-de-confidentialite">Confidentialité</a>
        <a href="/rss.xml">Flux RSS</a>
      </nav>
      <p>&copy; {new Date().getFullYear()} PulseNews. Tous droits réservés.</p>
    </footer>

    <style is:global>
      :root {
        --bg-color: #0f172a;
        --card-bg: #1e293b;
        --text-color: #f8fafc;
        --text-muted: #94a3b8;
        --accent-color: #38bdf8;
        --border-color: #334155;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
      }

      .header-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .site-header {
        border-bottom: 1px solid var(--border-color);
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
      }

      .logo span {
        color: var(--accent-color);
      }

      .main-nav {
        display: flex;
        gap: 1.5rem;
      }

      .main-nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
      }

      .main-nav a:hover {
        color: var(--accent-color);
      }

      .main-content {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1.5rem;
        min-height: 80vh;
      }

      .site-footer {
        border-top: 1px solid var(--border-color);
        text-align: center;
        padding: 2rem;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
      }

      .footer-nav a {
        color: var(--text-muted);
        text-decoration: none;
      }

      .footer-nav a:hover {
        color: var(--accent-color);
      }
    </style>
  </body>
</html>
